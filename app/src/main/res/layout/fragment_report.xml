<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/page_bg"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:paddingBottom="16dp">

        <!-- ===== 当前车辆（报表跟随当前选中车辆，不提供切换以免与其它页冲突） ===== -->
        <TextView
            android:id="@+id/tvReportVehicle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:background="@color/card_bg"
            android:padding="12dp"
            android:textColor="@color/text_primary"
            android:textSize="15sp"
            android:textStyle="bold" />

        <!-- ===== 关键指标 ===== -->
        <TextView
            style="@style/SectionTitle"
            android:text="@string/section_kpi" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <com.google.android.material.card.MaterialCardView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_margin="4dp"
                android:layout_weight="1"
                app:cardCornerRadius="8dp"
                app:cardElevation="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="10dp">

                    <TextView
                        style="@style/StatLabel"
                        android:text="@string/report_total_cost" />

                    <TextView
                        android:id="@+id/tvTotalCost"
                        style="@style/StatValue"
                        android:text="@string/value_placeholder" />

                    <TextView
                        style="@style/StatUnit"
                        android:text="@string/unit_yuan" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_margin="4dp"
                android:layout_weight="1"
                app:cardCornerRadius="8dp"
                app:cardElevation="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="10dp">

                    <TextView
                        style="@style/StatLabel"
                        android:text="@string/report_month_avg" />

                    <TextView
                        android:id="@+id/tvMonthAvg"
                        style="@style/StatValue"
                        android:text="@string/value_placeholder" />

                    <TextView
                        style="@style/StatUnit"
                        android:text="@string/unit_yuan" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <com.google.android.material.card.MaterialCardView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_margin="4dp"
                android:layout_weight="1"
                app:cardCornerRadius="8dp"
                app:cardElevation="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="10dp">

                    <TextView
                        style="@style/StatLabel"
                        android:text="@string/report_cost_per_km" />

                    <TextView
                        android:id="@+id/tvCostPerKm"
                        style="@style/StatValue"
                        android:text="@string/value_placeholder" />

                    <TextView
                        style="@style/StatUnit"
                        android:text="@string/unit_yuan_km" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_margin="4dp"
                android:layout_weight="1"
                app:cardCornerRadius="8dp"
                app:cardElevation="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="10dp">

                    <TextView
                        style="@style/StatLabel"
                        android:text="@string/report_odo_total" />

                    <TextView
                        android:id="@+id/tvOdoTotal"
                        style="@style/StatValue"
                        android:text="@string/value_placeholder" />

                    <TextView
                        style="@style/StatUnit"
                        android:text="@string/unit_km" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>
        </LinearLayout>

        <!-- ===== 月度趋势 ===== -->
        <TextView
            style="@style/SectionTitle"
            android:text="@string/report_monthly_title" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@color/card_bg"
            android:orientation="vertical"
            android:padding="12dp">

            <com.jtpv.powerconsumption.MonthlyBarChartView
                android:id="@+id/chartMonthly"
                android:layout_width="match_parent"
                android:layout_height="180dp" />

            <!-- 图例：柱状图用颜色区分补能与其他费用 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:gravity="center"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="4dp"
                    android:background="@color/chart_fuel"
                    android:text="  "
                    android:textSize="10sp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="16dp"
                    android:text="@string/report_fuel_cost"
                    android:textColor="@color/text_secondary"
                    android:textSize="11sp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="4dp"
                    android:background="@color/chart_other"
                    android:text="  "
                    android:textSize="10sp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/report_other_cost"
                    android:textColor="@color/text_secondary"
                    android:textSize="11sp" />
            </LinearLayout>
        </LinearLayout>

        <!-- ===== 补能费用明细 ===== -->
        <TextView
            style="@style/SectionTitle"
            android:text="@string/report_charge_cost" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@color/card_bg"
            android:orientation="horizontal"
            android:padding="12dp">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    style="@style/StatLabel"
                    android:text="@string/report_charge_cost" />

                <TextView
                    android:id="@+id/tvChargeCost"
                    style="@style/StatValue"
                    android:text="@string/value_placeholder"
                    android:textColor="@color/ev_color" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    style="@style/StatLabel"
                    android:text="@string/report_fuel_cost" />

                <TextView
                    android:id="@+id/tvFuelCost"
                    style="@style/StatValue"
                    android:text="@string/value_placeholder"
                    android:textColor="@color/fuel_color" />
            </LinearLayout>
        </LinearLayout>

        <!-- ===== 费用构成 ===== -->
        <TextView
            style="@style/SectionTitle"
            android:text="@string/report_breakdown_title" />

        <LinearLayout
            android:id="@+id/llBreakdown"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@color/card_bg"
            android:orientation="vertical"
            android:padding="12dp" />

        <TextView
            android:id="@+id/tvBreakdownEmpty"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="12dp"
            android:text="@string/report_no_expense"
            android:textColor="@color/text_secondary"
            android:textSize="12sp" />
    </LinearLayout>
</ScrollView>
