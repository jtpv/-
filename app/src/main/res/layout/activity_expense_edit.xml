<?xml version="1.0" encoding="utf-8"?>
<!-- 费用录入 / 编辑表单：与补能表单同一规范——标签在左、输入框在右 -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/page_bg"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            style="@style/FormLabel"
            android:text="@string/label_expense_type" />

        <Spinner
            android:id="@+id/spinnerType"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="44dp" />

        <LinearLayout style="@style/LabelRow">

            <TextView
                style="@style/RowLabel"
                android:text="@string/label_date" />

            <EditText
                android:id="@+id/etExpDate"
                style="@style/FieldText"
                android:inputType="date" />
        </LinearLayout>

        <LinearLayout style="@style/LabelRow">

            <TextView
                style="@style/RowLabel"
                android:text="@string/label_expense_amount" />

            <EditText
                android:id="@+id/etExpAmount"
                style="@style/FieldText"
                android:inputType="numberDecimal" />
        </LinearLayout>

        <LinearLayout style="@style/LabelRow">

            <TextView
                style="@style/RowLabel"
                android:text="@string/label_expense_odo" />

            <EditText
                android:id="@+id/etExpOdo"
                style="@style/FieldText"
                android:inputType="number" />
        </LinearLayout>

        <LinearLayout style="@style/LabelRow">

            <TextView
                style="@style/RowLabel"
                android:text="@string/label_shop" />

            <EditText
                android:id="@+id/etExpShop"
                style="@style/FieldText"
                android:inputType="text" />
        </LinearLayout>

        <!-- ===== 备注：内容可能较长（保养项目明细），保留整行多行输入 ===== -->
        <TextView
            style="@style/FormLabel"
            android:text="@string/label_note" />

        <EditText
            android:id="@+id/etExpNote"
            style="@style/FormInput"
            android:gravity="top"
            android:hint="@string/hint_expense_note"
            android:inputType="textMultiLine" />

        <Button
            android:id="@+id/btnSaveExpense"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:minHeight="48dp"
            android:text="@string/action_save" />
    </LinearLayout>
</ScrollView>
