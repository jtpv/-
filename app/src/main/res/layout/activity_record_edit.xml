<?xml version="1.0" encoding="utf-8"?>
<!--
  补能记录录入 / 编辑表单。
  设计要点：每个输入项都有独立标签置于输入框上方，而非依赖框内 hint——
  hint 在用户输入后即消失，且颜色浅不显眼；显式标签让表单含义始终可见。
-->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/page_bg"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- ===== 记录类型 ===== -->
        <RadioGroup
            android:id="@+id/rgType"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <RadioButton
                android:id="@+id/rbCharge"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:checked="true"
                android:text="@string/type_charge" />

            <RadioButton
                android:id="@+id/rbFuel"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/type_fuel" />
        </RadioGroup>

        <!-- ===== 基本信息 ===== -->
        <TextView
            style="@style/FormLabel"
            android:text="@string/label_date" />

        <EditText
            android:id="@+id/etDate"
            style="@style/FormInput"
            android:inputType="date" />

        <!-- 标签文字随类型切换：充电量 (kWh) / 加油量 (L)，由 applyTypeUi() 控制 -->
        <TextView
            android:id="@+id/tvLabelAmount"
            style="@style/FormLabel"
            android:text="@string/label_amount_charge" />

        <EditText
            android:id="@+id/etAmount"
            style="@style/FormInput"
            android:inputType="numberDecimal" />

        <TextView
            style="@style/FormLabel"
            android:text="@string/label_price" />

        <EditText
            android:id="@+id/etPrice"
            style="@style/FormInput"
            android:inputType="numberDecimal" />

        <TextView
            style="@style/FormLabel"
            android:text="@string/label_cost" />

        <EditText
            android:id="@+id/etCost"
            style="@style/FormInput"
            android:inputType="numberDecimal" />

        <!-- ===== 里程（DM-i 提供 EV / HEV 两个独立计数器） ===== -->
        <TextView
            style="@style/FormLabel"
            android:text="@string/label_odo_total" />

        <EditText
            android:id="@+id/etOdoTotal"
            style="@style/FormInput"
            android:inputType="number" />

        <!-- EV / HEV 标签与输入框的可见性必须同步切换，否则会出现「只有框没有标签」 -->
        <TextView
            android:id="@+id/tvLabelOdoEv"
            style="@style/FormLabel"
            android:text="@string/label_odo_ev" />

        <EditText
            android:id="@+id/etOdoEv"
            style="@style/FormInput"
            android:inputType="number" />

        <TextView
            android:id="@+id/tvLabelOdoHev"
            style="@style/FormLabel"
            android:text="@string/label_odo_hev" />

        <EditText
            android:id="@+id/etOdoHev"
            style="@style/FormInput"
            android:inputType="number" />

        <!-- ===== 是否充满 / 加满（加满法是唯一独立校验手段） ===== -->
        <Switch
            android:id="@+id/swFull"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:minHeight="44dp"
            android:text="@string/label_is_full_charge" />

        <TextView
            style="@style/FormLabel"
            android:text="@string/label_note" />

        <!-- 多行输入：充电桩位置、跳枪异常等长内容更易填写 -->
        <EditText
            android:id="@+id/etNote"
            style="@style/FormInput"
            android:gravity="top"
            android:inputType="textMultiLine" />

        <Button
            android:id="@+id/btnSave"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:minHeight="48dp"
            android:text="@string/action_save" />
    </LinearLayout>
</ScrollView>
