<?xml version="1.0" encoding="utf-8"?>
<!--
  补能记录录入 / 编辑表单。
  布局规范：标签在左、输入框在右的横排行（LabelRow / FieldText 样式），
  比竖排更紧凑，一眼可对照字段名与填写内容。
-->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/page_bg"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- ===== 记录类型 ===== -->
        <RadioGroup
            android:id="@+id/rgType"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <RadioButton
                android:id="@+id/rbCharge"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:checked="true"
                android:text="@string/type_charge" />

            <RadioButton
                android:id="@+id/rbFuel"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/type_fuel" />
        </RadioGroup>

        <!-- ===== 基本信息：标签在左、输入框在右 ===== -->
        <LinearLayout style="@style/LabelRow">

            <TextView
                style="@style/RowLabel"
                android:text="@string/label_date" />

            <EditText
                android:id="@+id/etDate"
                style="@style/FieldText"
                android:inputType="date" />
        </LinearLayout>

        <!-- 标签文字随类型切换：充电量 (kWh) / 加油量 (L)，由 applyTypeUi() 控制 -->
        <LinearLayout style="@style/LabelRow">

            <TextView
                android:id="@+id/tvLabelAmount"
                style="@style/RowLabel"
                android:text="@string/label_amount_charge" />

            <EditText
                android:id="@+id/etAmount"
                style="@style/FieldText"
                android:inputType="numberDecimal" />
        </LinearLayout>

        <LinearLayout style="@style/LabelRow">

            <TextView
                style="@style/RowLabel"
                android:text="@string/label_price" />

            <EditText
                android:id="@+id/etPrice"
                style="@style/FieldText"
                android:inputType="numberDecimal" />
        </LinearLayout>

        <LinearLayout style="@style/LabelRow">

            <TextView
                style="@style/RowLabel"
                android:text="@string/label_cost" />

            <EditText
                android:id="@+id/etCost"
                style="@style/FieldText"
                android:inputType="numberDecimal" />
        </LinearLayout>

        <!-- ===== 里程（DM-i 提供 EV / HEV 两个独立计数器） ===== -->
        <LinearLayout style="@style/LabelRow">

            <TextView
                style="@style/RowLabel"
                android:text="@string/label_odo_total" />

            <EditText
                android:id="@+id/etOdoTotal"
                style="@style/FieldText"
                android:inputType="number" />
        </LinearLayout>

        <!-- EV / HEV 整行的可见性必须同步切换，否则会残留孤立的标签或输入框 -->
        <LinearLayout
            android:id="@+id/rowOdoEv"
            style="@style/LabelRow">

            <TextView
                style="@style/RowLabel"
                android:text="@string/label_odo_ev" />

            <EditText
                android:id="@+id/etOdoEv"
                style="@style/FieldText"
                android:inputType="number" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/rowOdoHev"
            style="@style/LabelRow">

            <TextView
                style="@style/RowLabel"
                android:text="@string/label_odo_hev" />

            <EditText
                android:id="@+id/etOdoHev"
                style="@style/FieldText"
                android:inputType="number" />
        </LinearLayout>

        <!-- ===== 是否充满 / 加满（加满法是唯一独立校验手段） ===== -->
        <Switch
            android:id="@+id/swFull"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:minHeight="44dp"
            android:text="@string/label_is_full_charge" />

        <!-- ===== 备注：内容可能较长（桩位置、跳枪异常），保留整行多行输入 ===== -->
        <TextView
            style="@style/FormLabel"
            android:text="@string/label_note" />

        <EditText
            android:id="@+id/etNote"
            style="@style/FormInput"
            android:gravity="top"
            android:inputType="textMultiLine" />

        <Button
            android:id="@+id/btnSave"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:minHeight="48dp"
            android:text="@string/action_save" />
    </LinearLayout>
</ScrollView>
