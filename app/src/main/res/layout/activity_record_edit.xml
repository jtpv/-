<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/page_bg"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- ===== 记录类型 ===== -->
        <RadioGroup
            android:id="@+id/rgType"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <RadioButton
                android:id="@+id/rbCharge"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:checked="true"
                android:text="@string/type_charge" />

            <RadioButton
                android:id="@+id/rbFuel"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/type_fuel" />
        </RadioGroup>

        <!-- ===== 基本信息 ===== -->
        <EditText
            android:id="@+id/etDate"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:hint="@string/hint_date"
            android:importantForAutofill="no"
            android:inputType="date"
            android:minHeight="44dp" />

        <EditText
            android:id="@+id/etAmount"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/hint_amount_charge"
            android:importantForAutofill="no"
            android:inputType="numberDecimal"
            android:minHeight="44dp" />

        <EditText
            android:id="@+id/etPrice"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/hint_price"
            android:importantForAutofill="no"
            android:inputType="numberDecimal"
            android:minHeight="44dp" />

        <EditText
            android:id="@+id/etCost"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/hint_cost"
            android:importantForAutofill="no"
            android:inputType="numberDecimal"
            android:minHeight="44dp" />

        <!-- ===== 里程（DM-i 提供 EV / HEV 两个独立计数器） ===== -->
        <EditText
            android:id="@+id/etOdoTotal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/hint_odo_total"
            android:importantForAutofill="no"
            android:inputType="number"
            android:minHeight="44dp" />

        <EditText
            android:id="@+id/etOdoEv"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/hint_odo_ev"
            android:importantForAutofill="no"
            android:inputType="number"
            android:minHeight="44dp" />

        <EditText
            android:id="@+id/etOdoHev"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/hint_odo_hev"
            android:importantForAutofill="no"
            android:inputType="number"
            android:minHeight="44dp" />

        <!-- ===== 是否充满 / 加满（加满法是唯一独立校验手段） ===== -->
        <Switch
            android:id="@+id/swFull"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:minHeight="44dp"
            android:text="@string/label_is_full_charge" />

        <EditText
            android:id="@+id/etNote"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/hint_note"
            android:importantForAutofill="no"
            android:inputType="text"
            android:minHeight="44dp" />

        <Button
            android:id="@+id/btnSave"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:minHeight="48dp"
            android:text="@string/action_save" />
    </LinearLayout>
</ScrollView>
