# ===== 工作区数据（不纳入版本控制） =====
.workbuddy/

# ===== 操作系统 =====
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/
.DS_Store

# ===== 编辑器 / IDE =====
.vscode/
.idea/
*.swp
*.swo

# ===== Python =====
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.venv/
venv/
env/
.pytest_cache/
.mypy_cache/

# ===== Node.js =====
node_modules/
npm-debug.log*
yarn-error.log*
.pnpm-debug.log*

# ===== 日志与临时文件 =====
*.log
*.tmp
*.temp
~$*
*.bak
*.orig

# ===== 敏感信息（切勿提交） =====
.env
.env.local
*.pem
*.key
credentials.json
*credentials*

# ===== Android / Gradle =====
local.properties
*.jks
*.keystore
.gradle/
build/
captures/
.cxx/

# gradle wrapper 的 jar 是二进制，本机无法获取，改由 CI 的官方 action 注入；
# 但 .properties 是文本配置，需保留
gradle/wrapper/gradle-wrapper.jar
!gradle/wrapper/gradle-wrapper.properties
